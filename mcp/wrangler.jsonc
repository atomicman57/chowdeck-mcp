{
  "$schema": "node_modules/wrangler/config-schema.json",
  "triggers": {"crons": ["*/5 * * * *"]},
  "name": "chowdeck-mcp",
  "main": "hosting/worker.bundle.mjs",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm run build:hosted"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHOWDECK_ACCOUNT",
        "class_name": "ChowdeckAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChowdeckAccount"
      ]
    }
  ],
  "d1_databases": [
  {
    "binding": "MCP_STORAGE",
    "database_name": "chowdeck-mcp-storage",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }
],
  "vars": {
    "CHOWDECK_WORKERS_PLAN": "free",
    "CHOWDECK_SUBREQUEST_LIMIT": "50"
  }
}
